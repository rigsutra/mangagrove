---
import Layout from '../layouts/Layout.astro';
import { u, SITE_NAME } from '../lib/url';
---
<Layout title={`Page not found - ${SITE_NAME}`} description="This page does not exist.">
  <section class="card nf">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you are looking for moved or never existed.</p>
    <div class="cta"><a class="btn" href={u('/')}>Go home</a><a class="btn ghost" href={u('/browse/')}>Browse comics</a></div>
  </section>
</Layout>
<style>
  .nf { max-width:520px; margin:40px auto; text-align:center; padding:40px 24px; }
  .code { margin:0; font-size:64px; font-weight:800; line-height:1; background:linear-gradient(135deg,var(--accent),#d08cff); -webkit-background-clip:text; background-clip:text; color:transparent; }
  h1 { margin:12px 0 6px; } p { color:var(--mute); }
  .cta { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:20px; }
</style>

---
import Layout from '../../../../layouts/Layout.astro';
import { allSeries, oldest, readUrl, seriesUrl, pageUrl, cover, LANG_LABEL, SITE_NAME, hreflang } from '../../../../lib/url';
export function getStaticPaths() {
  return allSeries.flatMap((s) => s.chapters.flatMap((c) => Object.keys(c.langs).map((lang) => ({ params: { slug: s.slug, lang, chapter: String(c.n) }, props: { s, c, lang } }))));
}
const { s, c, lang } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const sorted = oldest(s).filter((x) => x.langs[lang]);
const i = sorted.findIndex((x) => x.n === c.n);
const prev = sorted[i - 1], next = sorted[i + 1];
const dims = c.langs[lang];
const label = LANG_LABEL[lang] ?? lang;
const url = readUrl(s, c.n, lang);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ComicIssue', name: `${s.title} Chapter ${c.n}: ${c.title}`, issueNumber: c.n, inLanguage: lang,
  datePublished: c.date, url: abs(url), image: abs(pageUrl(s, lang, c.n, Math.min(1, dims.length - 1))),
  ...(s.credit ? { creditText: s.credit } : {}),
  isPartOf: { '@type': 'ComicSeries', name: s.title, url: abs(seriesUrl(s)) },
};
const alternates = Object.keys(c.langs).map((l) => ({ lang: l, href: readUrl(s, c.n, l) }));
---
<Layout
  title={`${s.title} Chapter ${c.n}: ${c.title} (${label}) - Read Online | ${SITE_NAME}`}
  description={`Read ${s.title} Chapter ${c.n} "${c.title}" free online in ${label}. ${dims.length} pages, mobile friendly reader on ${SITE_NAME}.`}
  image={cover(s)} imageAlt={`${s.title} cover`} type="article" lang={lang} jsonLd={jsonLd} alternates={alternates}
  crumbs={[{ name: s.title, href: seriesUrl(s) }, { name: `Chapter ${c.n}`, href: url }]}
>
  <div class="reader">
    <header class="rhead">
      <h1><span class="rs">{s.title}</span> Chapter {c.n}: {c.title}</h1>
      <div class="langs" role="group" aria-label="Language">
        {Object.keys(c.langs).map((l) => <a class:list={['pill', l === lang && 'on']} href={readUrl(s, c.n, l)} hreflang={hreflang(l)} aria-current={l === lang ? 'page' : undefined}>{LANG_LABEL[l] ?? l}</a>)}
      </div>
    </header>
    <div class="pages">
      {dims.map(([w, h], k) => <img src={pageUrl(s, lang, c.n, k)} width={w} height={h} alt={`${s.title} chapter ${c.n} page ${k + 1}`} loading={k < 2 ? 'eager' : 'lazy'} fetchpriority={k === 0 ? 'high' : undefined} decoding="async" />)}
    </div>
    <div class="end">
      <p>End of Chapter {c.n}</p>
      {next ? <a class="btn" href={readUrl(s, next.n, lang)}>Next: Chapter {next.n} - {next.title}</a> : <a class="btn ghost" href={seriesUrl(s)}>Back to all chapters</a>}
    </div>
    {s.credit && <p class="credit">{s.credit}</p>}
  </div>
  <nav class="rnav" aria-label="Chapter navigation">
    {prev ? <a class="btn ghost" href={readUrl(s, prev.n, lang)} rel="prev" data-key="ArrowLeft">‹ Prev</a> : <span class="btn ghost off" aria-disabled="true">‹ Prev</span>}
    <a class="btn ghost mid" href={seriesUrl(s)}>Ch. {c.n} / {sorted.length}</a>
    {next ? <a class="btn" href={readUrl(s, next.n, lang)} rel="next" data-key="ArrowRight">Next ›</a> : <span class="btn off" aria-disabled="true">Next ›</span>}
  </nav>
</Layout>
<style>
  .reader { max-width:900px; margin:0 auto; padding-bottom:84px; }
  .rhead { display:grid; gap:10px; margin-bottom:14px; }
  h1 { margin:0; font-size:clamp(18px,2.6vw,22px); }
  .rs { display:block; color:var(--accent2); font-size:13px; font-weight:600; letter-spacing:.02em; margin-bottom:2px; }
  .langs { display:flex; gap:8px; flex-wrap:wrap; }
  .pages { background:#000; border-radius:var(--r-sm); overflow:hidden; box-shadow:var(--shadow); }
  .pages img { width:100%; }
  .end { margin:28px 0 8px; display:grid; justify-items:center; gap:12px; text-align:center; }
  .end p { margin:0; color:var(--mute); font-size:13px; text-transform:uppercase; letter-spacing:.08em; }
  .end .btn { max-width:100%; }
  .credit { color:var(--mute); font-size:12.5px; text-align:center; }
  .rnav { position:fixed; left:0; right:0; bottom:0; z-index:30; display:grid; grid-template-columns:1fr 1.2fr 1fr; gap:8px; padding:10px 12px calc(10px + env(safe-area-inset-bottom)); background:rgba(13,11,20,.88); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-top:1px solid var(--line); }
  .rnav .btn { width:100%; padding:0 12px; white-space:nowrap; }
  .rnav .mid { font-variant-numeric:tabular-nums; }
  .rnav .off { opacity:.35; pointer-events:none; }
  @media (max-width:640px){ .pages { margin-left:calc(-1 * var(--gutter)); margin-right:calc(-1 * var(--gutter)); border-radius:0; } }
  @media (min-width:900px){ .rnav { left:50%; right:auto; width:min(560px,100%); transform:translateX(-50%); bottom:14px; border:1px solid var(--line2); border-radius:16px; padding:8px; box-shadow:var(--shadow); } }
</style>
<script>
  // Left/right arrow keys move between chapters.
  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('input, textarea')) return;
    const a = document.querySelector<HTMLAnchorElement>(`.rnav a[data-key="${e.key}"]`);
    if (a) location.href = a.href;
  });
</script>

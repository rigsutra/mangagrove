---
import Layout from '../../layouts/Layout.astro';
import { allSeries, cover, latest, u } from '../../lib/url';
export function getStaticPaths() { return allSeries.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const first = [...s.chapters].sort((a, b) => a.n - b.n)[0];
---
<Layout title={`${s.title} - Read Online in Hinglish | Hinglish Scans`} description={s.synopsis} image={cover(s)} type="article">
  <div class="head card">
    <img src={cover(s)} alt={s.title} />
    <div>
      <h1>{s.title}</h1>
      <p><span class="chip">{s.status}</span> {s.genres.map((g) => <span class="chip">{g}</span>)}</p>
      <p class="syn">{s.synopsis}</p>
      <a class="btn" href={u(`/series/${s.slug}/${first.n}`)}>Read Chapter {first.n}</a>
    </div>
  </div>
  <section class="card" style="margin-top:18px">
    <h2>Chapters ({s.chapters.length})</h2>
    <ul class="chs">
      {latest(s).map((c) => (
        <li><a href={u(`/series/${s.slug}/${c.n}`)}><span>Chapter {c.n}{c.title ? ` - ${c.title}` : ''}</span><time>{c.date} · {c.pages} pages</time></a></li>
      ))}
    </ul>
  </section>
</Layout>
<style>
  .head { display:flex; gap:24px; } .head img { width:220px; border-radius:14px; align-self:flex-start; }
  h1 { margin:0 0 10px; } .syn { color:#d6d0ec; max-width:70ch; }
  .chs { list-style:none; margin:0; padding:0; display:grid; gap:8px; }
  .chs a { display:flex; justify-content:space-between; gap:12px; padding:12px 14px; background:var(--panel2); border:1px solid var(--line); border-radius:10px; }
  .chs a:hover { border-color:var(--accent); } time { color:var(--mute); font-size:12.5px; }
  @media (max-width:700px){ .head{flex-direction:column; align-items:center; text-align:center;} .chs a{flex-direction:column;} }
</style>

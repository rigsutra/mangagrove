---
import Layout from '../layouts/Layout.astro';
import { allSeries, cover, latest, oldest, readUrl, seriesUrl, primaryLang, u, LANG_LABEL, SITE_NAME } from '../lib/url';
// Featured slider: up to 10 series, most recently updated first. New series (first chapter < 14 days old) rank above plain new chapters; ties go to the series added last in series.json.
const day = (d: string) => Date.parse(d) / 864e5;
const newest = Math.max(...allSeries.map((s) => day(latest(s)[0].date)));
const slides = allSeries
  .map((s, i) => {
    const last = latest(s)[0];
    const isNew = day(oldest(s)[0].date) >= newest - 14;
    return { s, i, last, isNew, t: day(last.date) };
  })
  .sort((a, b) => b.t - a.t || Number(b.isNew) - Number(a.isNew) || b.i - a.i)
  .slice(0, 10);
const featured = slides[0].s;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const names = allSeries.map((s) => s.title.replace(/ \(Hinglish\)$/, ''));
const description = `Read ${names.slice(0, 4).join(', ')} and more free online in Hinglish, Hindi and English on MangaGrove. Fast, mobile friendly reader with no pop-ups.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: abs(u('/')),
  description,
  inLanguage: ['en', 'hi', 'hi-Latn'],
  potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: abs(u('/browse/')) + '?q={search_term_string}' }, 'query-input': 'required name=search_term_string' },
};
---
<Layout title={`${SITE_NAME} - Read Manga Online in Hinglish, Hindi & English`} description={description} image={cover(featured)} imageAlt={`${featured.title} cover`} active="home" jsonLd={jsonLd}>
  <div class="intro">
    <h1>Read webcomics free in English &amp; हिन्दी</h1>
    <p>Hand-picked comics, translated and tuned for reading on your phone. No sign-up, no pop-ups.</p>
  </div>

  <section class="hero" aria-roledescription="carousel" aria-label="Featured comics">
    <div class="track" id="track">
      {slides.map(({ s, last, isNew }, k) => (
        <article class="slide" aria-roledescription="slide" aria-label={`${k + 1} of ${slides.length}`}>
          <div class="hero-bg" style={`background-image:url(${cover(s)})`}></div>
          <div class="hero-body">
            <a href={seriesUrl(s)} class="hero-cover"><img src={cover(s)} alt={`${s.title} cover`} width="220" height="308" fetchpriority={k === 0 ? 'high' : 'auto'} loading={k === 0 ? 'eager' : 'lazy'} /></a>
            <div class="hero-text">
              <span class="chip solid">{isNew ? 'New series' : `New: Chapter ${last.n}`}</span>
              <h2>{s.title}</h2>
              <p class="syn">{s.synopsis}</p>
              <ul class="chips">
                {s.genres.map((g) => <li class="chip">{g}</li>)}
                {s.langs.map((l) => <li class="chip">{LANG_LABEL[l] ?? l}</li>)}
                <li class="chip">{s.chapters.length} chapters</li>
              </ul>
              <div class="cta">
                <a class="btn" href={isNew ? readUrl(s, oldest(s)[0].n, primaryLang(oldest(s)[0])) : readUrl(s, last.n, primaryLang(last))}>{isNew ? 'Start reading' : `Read Chapter ${last.n}`}</a>
                <a class="btn ghost" href={seriesUrl(s)}>All chapters</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    {slides.length > 1 && (
      <>
        <button class="nav prev" type="button" aria-label="Previous">‹</button>
        <button class="nav next" type="button" aria-label="Next">›</button>
        <div class="dots">{slides.map((_, k) => <button type="button" class="dot" aria-label={`Go to slide ${k + 1}`}></button>)}</div>
      </>
    )}
  </section>

  <div class="cols">
    <section class="card">
      <h2>Trending Comics</h2>
      <div class="grid">
        {allSeries.map((s) => (
          <a class="tile" href={seriesUrl(s)}>
            <div class="img"><img src={cover(s)} alt={`${s.title} cover`} loading="lazy" decoding="async" width="300" height="400" /><span class="badge">{s.langs.map((l) => l.toUpperCase()).join(' · ')}</span></div>
            <div class="t">{s.title}</div>
            <div class="s">Chapter {latest(s)[0].n}</div>
          </a>
        ))}
      </div>
    </section>
    <aside class="card">
      <h2>Popular</h2>
      <ol class="pop">
        {allSeries.map((s, i) => (
          <li><a href={seriesUrl(s)}><b>{i + 1}</b><img src={cover(s)} alt="" loading="lazy" width="44" height="58" /><span><span class="pt">{s.title}</span><span class="ps">{s.genres.join(', ')}</span></span></a></li>
        ))}
      </ol>
    </aside>
  </div>

  <section class="card latest">
    <h2>Latest Updates</h2>
    <div class="updates">
      {allSeries.map((s) => (
        <article class="upd">
          <a href={seriesUrl(s)} tabindex="-1" aria-hidden="true"><img src={cover(s)} alt="" loading="lazy" decoding="async" width="84" height="112" /></a>
          <div class="upd-body">
            <h3><a class="ut" href={seriesUrl(s)}>{s.title}</a></h3>
            <ul>
              {latest(s).slice(0, 3).map((c) => (
                <li><a href={readUrl(s, c.n, primaryLang(c))}><span>Ch. {c.n} · {c.title}</span><time datetime={c.date}>{c.date}</time></a></li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
<script>
  const track = document.getElementById('track');
  if (track) {
    const slides = [...track.children] as HTMLElement[];
    const dots = [...document.querySelectorAll<HTMLElement>('.dot')];
    const cur = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (k: number) => track.scrollTo({ left: ((k % slides.length) + slides.length) % slides.length * track.clientWidth, behavior: 'smooth' });
    const mark = () => dots.forEach((d, k) => d.classList.toggle('on', k === cur()));
    track.addEventListener('scroll', mark, { passive: true });
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    document.querySelector('.prev')?.addEventListener('click', () => go(cur() - 1));
    document.querySelector('.next')?.addEventListener('click', () => go(cur() + 1));
    let paused = false;
    const hero = track.parentElement!;
    ['mouseenter', 'focusin', 'touchstart'].forEach((e) => hero.addEventListener(e, () => (paused = true), { passive: true }));
    ['mouseleave', 'focusout'].forEach((e) => hero.addEventListener(e, () => (paused = false)));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => !paused && !document.hidden && go(cur() + 1), 6000);
    mark();
  }
</script>
<style>
  .intro { margin:4px 0 18px; }
  .intro h1 { margin:0; font-size:clamp(22px,3.2vw,30px); }
  .intro p { margin:6px 0 0; color:var(--mute); max-width:60ch; }

  .hero { position:relative; border-radius:var(--r-lg); overflow:hidden; border:1px solid var(--line); margin-bottom:18px; isolation:isolate; }
  .track { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .track::-webkit-scrollbar { display:none; }
  .slide { position:relative; flex:none; width:100%; scroll-snap-align:start; isolation:isolate; overflow:hidden; }
  .nav { position:absolute; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:50%; border:1px solid var(--line2); background:rgba(0,0,0,.55); color:#fff; font-size:24px; line-height:1; cursor:pointer; z-index:2; }
  .nav:hover { background:var(--accent); color:var(--accent-ink); }
  .prev { left:10px; } .next { right:10px; }
  .dots { position:absolute; bottom:10px; left:0; right:0; display:flex; justify-content:center; gap:4px; z-index:2; }
  .dot { width:24px; height:24px; padding:0; border:0; background:none; cursor:pointer; position:relative; }
  .dot::after { content:''; position:absolute; inset:8px; border-radius:50%; background:rgba(255,255,255,.4); }
  .dot.on::after { background:var(--accent); }
  .hero-bg { position:absolute; inset:0; z-index:-1; background-size:cover; background-position:center; filter:blur(32px) brightness(.4) saturate(1.2); transform:scale(1.25); }
  .slide::after { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,rgba(13,11,20,.75),rgba(13,11,20,.2)); }
  .hero-body { display:flex; gap:32px; padding:32px 64px 40px; align-items:center; }
  .hero-cover { flex:none; border-radius:14px; overflow:hidden; box-shadow:0 18px 50px rgba(0,0,0,.6); transition:transform .25s; }
  .hero-cover:hover { transform:translateY(-3px); }
  .hero-cover img { width:220px; }
  .hero h2 { margin:12px 0 8px; font-size:clamp(26px,4vw,40px); }
  .syn { color:var(--soft); max-width:62ch; margin:0; }
  .cta { display:flex; gap:10px; flex-wrap:wrap; margin-top:4px; }

  .cols { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:18px; align-items:start; }
  .pop { list-style:none; margin:0; padding:0; display:grid; gap:6px; }
  .pop a { display:flex; gap:12px; align-items:center; min-height:44px; padding:6px; border-radius:var(--r); transition:background .15s; }
  .pop a:hover { background:var(--panel2); }
  .pop b { color:var(--accent2); width:16px; text-align:center; font-size:15px; }
  .pop img { width:44px; height:58px; object-fit:cover; border-radius:8px; flex:none; }
  .pt { display:block; font-weight:600; font-size:14px; } .ps { display:block; color:var(--mute); font-size:12px; }

  .latest { margin-top:18px; }
  .updates { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,360px),1fr)); gap:14px; }
  .upd { display:flex; gap:14px; background:var(--panel2); border:1px solid var(--line); border-radius:var(--r); padding:12px; }
  .upd > a { flex:none; width:84px; height:112px; border-radius:10px; overflow:hidden; align-self:flex-start; }
  .upd img { width:100%; height:100%; object-fit:cover; }
  .upd-body { flex:1; min-width:0; }
  .upd h3 { margin:2px 0 0; font-size:15px; } .ut:hover { color:var(--accent2); }
  .upd ul { list-style:none; padding:0; margin:8px 0 0; display:grid; grid-template-columns:minmax(0,1fr); gap:6px; }
  .upd li a { display:flex; justify-content:space-between; align-items:center; gap:10px; min-height:36px; padding:6px 10px; font-size:13.5px; background:var(--panel); border:1px solid transparent; border-radius:8px; transition:border-color .15s; }
  .upd li a:hover { border-color:var(--accent); }
  .upd li span { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  @media (max-width:900px){ .cols{grid-template-columns:1fr;} .hero-body{flex-direction:column; text-align:center; gap:20px;} .hero-cover img{width:160px;} .chips,.cta{justify-content:center;} .syn{margin:0 auto;} .slide::after{background:rgba(13,11,20,.45);} }
  @media (max-width:640px){ .hero-body{padding:22px 16px 40px;} .nav{display:none;} .cta .btn{flex:1;} }
</style>
